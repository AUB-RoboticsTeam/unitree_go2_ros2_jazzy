<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- gz-sim only uses the 0.8 m minimum as a near-clip plane, so the ROS 2 cloud still
         shows the floor rings right around the robot. Classic drops every return below
         the minimum, so a shorter minimum reproduces that pattern. -->
    <xacro:property name="lidar_min_range" value="0.1"/>

    <!-- Unitree L1 4D lidar, mounted under the head as in unitree_go2_ros2_jazzy -->
    <link name="lidar_l1_link">
        <inertial>
            <mass value="0.5"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://go2_description/meshes/L1_4D_Lidar.dae" scale="1 1 1"/>
            </geometry>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://go2_description/meshes/L1_4D_Lidar.dae" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="lidar_l1_joint" type="fixed">
        <parent link="base"/>
        <child link="lidar_l1_link"/>
        <origin rpy="2.879 0.0 1.5705" xyz="0.25 -0.038 -0.03"/>
    </joint>

    <!-- Keep the sensor on its own link in the SDF so the cloud is published in lidar_l1_link. -->
    <gazebo reference="lidar_l1_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <!-- 600 x 30 rays, 360 deg x 90 deg, 0.8-30 m, 10 Hz: same pattern as the gz-sim gpu_lidar -->
    <gazebo reference="lidar_l1_link">
        <sensor name="lidar_l1" type="gpu_ray">
            <update_rate>10</update_rate>
            <visualize>false</visualize>
            <always_on>true</always_on>
            <ray>
                <scan>
                    <horizontal>
                        <samples>600</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>30</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.785398</min_angle>
                        <max_angle>0.785398</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>${lidar_min_range}</min>
                    <max>30.0</max>
                    <resolution>0.001</resolution>
                </range>
            </ray>
            <plugin name="unitree_lidar_plugin" filename="libgazebo_ros_velodyne_gpu_laser.so">
                <topicName>/unitree_lidar/points_raw</topicName>
                <frameName>lidar_l1_link</frameName>
                <organize_cloud>false</organize_cloud>
                <min_range>${lidar_min_range}</min_range>
                <max_range>30.0</max_range>
                <gaussianNoise>0.008</gaussianNoise>
            </plugin>
        </sensor>
    </gazebo>
</robot>
